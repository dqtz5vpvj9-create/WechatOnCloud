{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "yunwei-taskbar",
  "description": "Grants the deployed 云微 UI access to native unread and tray commands.",
  "windows": ["main", "tray-preview"],
  "remote": {
    "urls": ["https://wechat.tail.lixinrui000.cn/*"]
  },
  "permissions": [
    "allow-set-taskbar-unread",
    "allow-set-desktop-notification",
    "allow-set-desktop-default-route",
    "allow-set-tray-preview-hovered",
    "allow-open-tray-message",
    "allow-dismiss-tray-messages",
    "allow-open-download-path",
    "allow-get-taskbar-unread-state",
    "allow-show-tray-preview-for-test",
    "allow-get-desktop-runtime-state"
  ],
  "platforms": ["windows", "macOS"]
}
